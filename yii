UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.X then
        Settings.Fly.Enabled = not Settings.Fly.Enabled
        if guiButtons.Fly then
            guiButtons.Fly.Text = "Fly: " .. (Settings.Fly.Enabled and "ON" or "OFF") .. " (X)"
        end
    elseif input.KeyCode == Enum.KeyCode.Z then
        Settings.Aimbot.Enabled = not Settings.Aimbot.Enabled
        if guiButtons.Aimbot then
            guiButtons.Aimbot.Text = "Aimbot: " .. (Settings.Aimbot.Enabled and "ON" or "OFF")
        end
    elseif input.KeyCode == Enum.KeyCode.C then
        Settings.Aimbot.Silent = not Settings.Aimbot.Silent
        SilentAim.Enabled = Settings.Aimbot.Silent
        if guiButtons.Silent then
            guiButtons.Silent.Text = "Silent Aim: " .. (Settings.Aimbot.Silent and "ON" or "OFF")
        end
    end
end)

