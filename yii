-- MAIN LOOP
--------------------------------------------------
RS.RenderStepped:Connect(function(deltaTime)
    -- Movement
    local hum = getHum()
    if hum then
        hum.WalkSpeed = Settings.Movement.WalkSpeed
        if Settings.Movement.InfiniteJump then
            hum.JumpPower = Settings.Movement.JumpPower
            hum.Jump = true
        end
    end
    
    updateFly()
    ESP.Update()
    updateFOV()
    
    -- Get target for both regular and silent aim
    local target = getTarget()
    SilentAim.Target = target
    
    -- Regular aimbot
    if Settings.Aimbot.Enabled and not Settings.Aimbot.Silent then
        if target then
            local targetCFrame = CFrame.new(cam.CFrame.Position, target.Position)
            if Settings.Aimbot.Smoothness > 1 then
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, 1 / Settings.Aimbot.Smoothness)
            else
                cam.CFrame = targetCFrame
            end
        end
    end
    
    -- Silent aim (mouse method)
    if Settings.Aimbot.Silent and target then
        silentAimMouse(target)
    end
end)

