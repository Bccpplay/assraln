-- SILENT AIM SYSTEM
--------------------------------------------------
local SilentAim = {}
SilentAim.Target = nil
SilentAim.Enabled = false

-- Store original remote functions
local oldNamecall
local oldIndex

-- Hook into RemoteEvent/RemoteFunction firing
local function setupSilentAim()
    -- Method 1: Hook __namecall for RemoteEvent:FireServer
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        if method == "FireServer" and SilentAim.Enabled and SilentAim.Target then
            if Settings.Aimbot.Silent then
                -- Check hit chance
                if math.random(1, 100) > Settings.Aimbot.HitChance then
                    return oldNamecall(self, ...)
                end
                
                -- Modify the arguments to aim at target
                -- This depends on the game's specific remote structure
                -- Common pattern: FireServer(position, target, etc.)
                
                -- Try to detect and modify position/direction arguments
                local newArgs = {}
                for i, arg in pairs(args) do
                    if typeof(arg) == "Vector3" then
                        -- Replace position with target's head position
                        newArgs[i] = SilentAim.Target.Position
                    elseif typeof(arg) == "CFrame" then
                        -- Replace CFrame to look at target
                        local tool = plr.Character and plr.Character:FindFirstChildOfClass("Tool")
                        if tool and tool:FindFirstChild("Handle") then
                            local handlePos = tool.Handle.Position
                            newArgs[i] = CFrame.new(handlePos, SilentAim.Target.Position)
                        else
                            newArgs[i] = CFrame.new(arg.Position, SilentAim.Target.Position)
                        end
                    elseif typeof(arg) == "RaycastResult" or typeof(arg) == "Instance" then
                        -- If argument is a target instance, replace it
                        if arg:IsA("BasePart") then
                            newArgs[i] = SilentAim.Target
                        else
                            newArgs[i] = arg
                        end
                    else
                        newArgs[i] = arg
                    end
                end
                
                return oldNamecall(self, unpack(newArgs))
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    -- Method 2: Hook __index for tools/weapons
    local toolMT = {}
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if Settings.Aimbot.Silent and SilentAim.Enabled and SilentAim.Target then
            if key == "CFrame" and self:IsA("Camera") then
                return cam.CFrame
            end
        end
        return oldIndex(self, key)
    end)
end

-- Alternative silent aim using mouse movement (more compatible)
local function silentAimMouse(target)
    if not target then return end
    
    local targetPos, onScreen = cam:WorldToViewportPoint(target.Position)
    if not onScreen then return end
    
    -- Calculate the screen position of the target
    local screenTarget = Vector2.new(targetPos.X, targetPos.Y)
    
    -- Use mousemoverel for silent aim (undetectable movement)
    local mousePos = UIS:GetMouseLocation()
    local delta = screenTarget - mousePos
    
    -- Smooth the movement if needed
    if Settings.Aimbot.Smoothness > 1 then
        delta = delta / Settings.Aimbot.Smoothness
    end
    
    -- Move mouse silently
    mousemoverel(delta.X, delta.Y)
end

