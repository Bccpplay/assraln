RS.RenderStepped:Connect(function(deltaTime)
    local hum = getHum()
    if hum then
        hum.WalkSpeed = Settings.Movement.WalkSpeed
        if Settings.Movement.InfiniteJump then
            hum.JumpPower = Settings.Movement.JumpPower
            hum.Jump = true
        end
    end
    
    updateFly()
    ESP.Update()
    updateFOV()
    
    -- Regular aimbot with raycast and prediction
    if Settings.Aimbot.Enabled and not Settings.Aimbot.Silent then
        local target, predictedPos, bestPart = Prediction.GetBestTarget()
        if target and predictedPos then
            -- Use exact raycast hit position for precise aiming
            local aimPosition = predictedPos
            if Settings.Aimbot.UseRaycast and bestPart then
                aimPosition = RaycastSystem.GetHitPosition(bestPart, cam.CFrame.Position)
            end
            
            local targetCFrame = CFrame.new(cam.CFrame.Position, aimPosition)
            if Settings.Aimbot.Smoothness > 1 then
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, 1 / Settings.Aimbot.Smoothness)
            else
                cam.CFrame = targetCFrame
            end
        end
    end
    
    -- Silent aim (only when shooting)
    if Settings.Aimbot.Silent and ProjectileAim.Active then
        local projTarget, projPredicted = ProjectileAim.GetProjectileTarget()
        if projTarget and projPredicted then
            local screenPos = cam:WorldToViewportPoint(projPredicted)
            local mousePos = UIS:GetMouseLocation()
            local delta = Vector2.new(screenPos.X, screenPos.Y) - mousePos
            
            if delta.Magnitude <= Settings.Aimbot.FOV then
                if Settings.Aimbot.Smoothness > 1 then
                    delta = delta / Settings.Aimbot.Smoothness
                end
                mousemoverel(delta.X, delta.Y)
            end
        end
    end
end)

