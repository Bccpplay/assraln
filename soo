-- UTILITY FUNCTIONS
--------------------------------------------------
local function getChar()
    return plr.Character or plr.CharacterAdded:Wait()
end

local function getHum()
    return getChar():WaitForChild("Humanoid")
end

local function getHRP()
    return getChar():WaitForChild("HumanoidRootPart")
end

local function isEnemy(p)
    if p == plr then return false end
    if not Settings.ESP.TeamCheck then return true end
    if plr.Team and p.Team then
        return p.Team ~= plr.Team
    end
    return true
end

--------------------------------------------------
-- ADVANCED RAYCAST SYSTEM
--------------------------------------------------
local RaycastSystem = {}

-- Cache raycast parameters for performance
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Blacklist
rayParams.IgnoreWater = true

function RaycastSystem.IsVisible(target)
    if not Settings.Aimbot.VisibilityCheck then return true end
    
    local origin = cam.CFrame.Position
    local direction = (target.Position - origin).Unit * 1000
    
    -- Update filter to ignore local character
    rayParams.FilterDescendantsInstances = {plr.Character}
    
    local result = workspace:Raycast(origin, direction, rayParams)
    
    if result then
        -- Check if we hit the target or something on the target's character
        local hitInstance = result.Instance
        local hitChar = hitInstance:FindFirstAncestorOfClass("Model")
        
        if hitChar and hitChar == target.Parent then
            return true -- Hit the target's character
        end
        
        -- Check if we hit a part of the target itself
        if hitInstance:IsDescendantOf(target.Parent) then
            return true
        end
        
        return false -- Hit something else (wall, object, etc.)
    end
    
    return true -- No obstacle = visible
end

function RaycastSystem.GetHitPosition(target, origin)
    -- Cast ray from camera to target with bullet drop compensation
    local distance = (target.Position - origin).Magnitude
    local direction = (target.Position - origin).Unit
    
    rayParams.FilterDescendantsInstances = {plr.Character}
    
    local result = workspace:Raycast(origin, direction * distance, rayParams)
    
    if result then
        return result.Position -- Return exact hit position
    end
    
    return target.Position -- Return target position if no hit
end

function RaycastSystem.GetBestHitPart(character)
    -- Try to find the best part to aim at (prioritize head, then torso)
    local hitParts = {}
    
    local priorityParts = {
        character:FindFirstChild("Head"),
        character:FindFirstChild("UpperTorso"),
        character:FindFirstChild("Torso"),
        character:FindFirstChild("HumanoidRootPart")
    }
    
    for _, part in pairs(priorityParts) do
        if part and RaycastSystem.IsVisible(part) then
            return part
        end
    end
    
    -- Fallback: check all parts
    for _, part in pairs(character:GetChildren()) do
        if part:IsA("BasePart") and RaycastSystem.IsVisible(part) then
            table.insert(hitParts, part)
        end
    end
    
    -- Sort by closest to crosshair
    table.sort(hitParts, function(a, b)
        local aPos = cam:WorldToViewportPoint(a.Position)
        local bPos = cam:WorldToViewportPoint(b.Position)
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        return (Vector2.new(aPos.X, aPos.Y) - center).Magnitude < 
               (Vector2.new(bPos.X, bPos.Y) - center).Magnitude
    end)
    
    return hitParts[1]
end

--------------------------------------------------
-- TARGET PREDICTION SYSTEM (With Raycast)
--------------------------------------------------
local Prediction = {}

function Prediction.Calculate(targetPart, predictionTime)
    if not targetPart then return nil end
    
    local position = targetPart.Position
    local velocity = targetPart.Velocity or Vector3.zero
    
    -- Get more accurate velocity from HumanoidRootPart
    local char = targetPart.Parent
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Velocity.Magnitude > 1 then
            velocity = hrp.Velocity
        end
        
        -- Account for jumping
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            if hum.Jump and hum.JumpPower > 0 then
                velocity = velocity + Vector3.new(0, hum.JumpPower * 0.3, 0)
            end
            -- Account for falling
            if hum.FloorMaterial == Enum.Material.Air then
                velocity = velocity - Vector3.new(0, workspace.Gravity * predictionTime * 0.5, 0)
            end
        end
    end
    
    -- Predict position
    local predictedPosition = position + (velocity * predictionTime)
    
    -- Add gravity compensation for arcing projectiles
    if predictionTime > 0.05 then
        predictedPosition = predictedPosition - Vector3.new(0, (workspace.Gravity * predictionTime * predictionTime) / 2, 0)
    end
    
    -- Verify the predicted position is visible (not behind wall)
    if Settings.Aimbot.VisibilityCheck then
        local origin = cam.CFrame.Position
        local direction = (predictedPosition - origin).Unit * 1000
        rayParams.FilterDescendantsInstances = {plr.Character}
        local result = workspace:Raycast(origin, direction, rayParams)
        
        if result and not result.Instance:IsDescendantOf(char) then
            -- Prediction goes through wall, fall back to current position
            return targetPart.Position
        end
    end
    
    return predictedPosition
end

function Prediction.GetBestTarget()
    if not Settings.Aimbot.Enabled then return nil, nil, nil end
    
    local bestTarget, bestPredicted, bestPart, bestDist = nil, nil, nil, Settings.Aimbot.FOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        
        local char = player.Character
        if not char then continue end
        
        -- Get best visible hit part using raycast
        local targetPart
        if Settings.Aimbot.UseRaycast then
            targetPart = RaycastSystem.GetBestHitPart(char)
        else
            targetPart = char:FindFirstChild(Settings.Aimbot.TargetPart)
        end
        
        if not targetPart then continue end
        
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        -- Auto-adjust prediction based on distance
        local predictionTime = Settings.Aimbot.PredictionAmount
        if Settings.Aimbot.AutoPrediction then
            local distance = (targetPart.Position - cam.CFrame.Position).Magnitude
            predictionTime = math.clamp(distance / 500, 0.05, 0.3) -- Scale with distance
        end
        
        -- Calculate predicted position
        local predictedPos
        if Settings.Aimbot.PredictionEnabled then
            predictedPos = Prediction.Calculate(targetPart, predictionTime)
        else
            predictedPos = targetPart.Position
        end
        
        -- Verify with raycast
        if Settings.Aimbot.UseRaycast and Settings.Aimbot.VisibilityCheck then
            if not RaycastSystem.IsVisible(targetPart) then continue end
            
            -- Check if predicted position is also visible
            local rayOrigin = cam.CFrame.Position
            local rayDirection = (predictedPos - rayOrigin).Unit * 1000
            rayParams.FilterDescendantsInstances = {plr.Character}
            local result = workspace:Raycast(rayOrigin, rayDirection, rayParams)
            
            if result and not result.Instance:IsDescendantOf(char) then
                -- Prediction blocked, use current position instead
                predictedPos = RaycastSystem.GetHitPosition(targetPart, rayOrigin)
            end
        end
        
        -- Convert to screen coordinates
        local screenPos, onScreen = cam:WorldToViewportPoint(predictedPos)
        if not onScreen then continue end
        
        local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        
        if distance < bestDist then
            bestDist = distance
            bestTarget = targetPart
            bestPredicted = predictedPos
            bestPart = targetPart
        end
    end
    
    return bestTarget, bestPredicted, bestPart
end

--------------------------------------------------
-- PROJECTILE SILENT AIM (Raycast-based)
--------------------------------------------------
local ProjectileAim = {}
ProjectileAim.Active = false

function ProjectileAim.CalculateTrajectory(startPos, targetPos, targetVel, projectileSpeed)
    if not projectileSpeed or projectileSpeed <= 0 then
        return targetPos
    end
    
    local gravity = workspace.Gravity
    local distance = (targetPos - startPos).Magnitude
    local travelTime = distance / projectileSpeed
    
    local predictedPos = targetPos + (targetVel * travelTime)
    
    -- Add gravity drop compensation
    local drop = Vector3.new(0, (gravity * travelTime * travelTime) / 2, 0)
    predictedPos = predictedPos - drop
    
    -- Raycast verification
    if Settings.Aimbot.VisibilityCheck then
        rayParams.FilterDescendantsInstances = {plr.Character}
        local result = workspace:Raycast(startPos, (predictedPos - startPos).Unit * distance * 1.5, rayParams)
        if result then
            predictedPos = result.Position
        end
    end
    
    return predictedPos
end

function ProjectileAim.GetProjectileTarget()
    if not Settings.Aimbot.Silent then return nil, nil end
    if not ProjectileAim.Active then return nil, nil end
    
    local bestTarget, bestPredicted, bestDist = nil, nil, Settings.Aimbot.FOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        
        local char = player.Character
        if not char then continue end
        
        -- Use raycast to find best hit part
        local targetPart
        if Settings.Aimbot.UseRaycast then
            targetPart = RaycastSystem.GetBestHitPart(char)
        else
            targetPart = char:FindFirstChild(Settings.Aimbot.TargetPart)
        end
        
        if not targetPart then continue end
        
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        if Settings.Aimbot.VisibilityCheck and not RaycastSystem.IsVisible(targetPart) then continue end
        
        -- Get projectile speed from tool if available
        local projectileSpeed = 300
        local tool = plr.Character and plr.Character:FindFirstChildOfClass("Tool")
        if tool then
            -- Try to detect projectile speed from tool config
            local config = tool:FindFirstChild("Configuration") or tool:FindFirstChild("Config")
            if config then
                local speed = config:FindFirstChild("BulletSpeed") or config:FindFirstChild("ProjectileSpeed") or config:FindFirstChild("Speed")
                if speed and speed.Value then
                    projectileSpeed = speed.Value
                end
            end
        end
        
        local startPos = RaycastSystem.GetHitPosition(targetPart, cam.CFrame.Position)
        local targetVel = targetPart.Velocity or Vector3.zero
        local predictedPos = ProjectileAim.CalculateTrajectory(startPos, targetPart.Position, targetVel, projectileSpeed)
        
        local screenPos, onScreen = cam:WorldToViewportPoint(predictedPos)
        if not onScreen then continue end
        
        local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        
        if distance < bestDist then
            bestDist = distance
            bestTarget = targetPart
            bestPredicted = predictedPos
        end
    end
    
    return bestTarget, bestPredicted
end

