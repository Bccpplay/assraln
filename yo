local ESP = {}
ESP.Objects = {}

function ESP.Create(player)
    if player == plr then return end
    
    local drawings = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Tracer = Drawing.new("Line"),
        HealthBar = Drawing.new("Line"),
        HealthBg = Drawing.new("Line")
    }
    
    drawings.Box.Color = Settings.ESP.Color
    drawings.Box.Thickness = 1.5
    drawings.Box.Filled = false
    drawings.Box.Visible = false
    
    drawings.Name.Size = 13
    drawings.Name.Center = true
    drawings.Name.Outline = true
    drawings.Name.Color = Color3.new(1, 1, 1)
    drawings.Name.Visible = false
    
    drawings.Distance.Size = 12
    drawings.Distance.Center = true
    drawings.Distance.Outline = true
    drawings.Distance.Color = Color3.new(1, 1, 1)
    drawings.Distance.Visible = false
    
    drawings.Tracer.Color = Settings.ESP.Color
    drawings.Tracer.Thickness = 1
    drawings.Tracer.Transparency = 0.7
    drawings.Tracer.Visible = false
    
    drawings.HealthBar.Color = Color3.new(0, 1, 0)
    drawings.HealthBar.Thickness = 2
    drawings.HealthBar.Visible = false
    
    drawings.HealthBg.Color = Color3.new(0.3, 0, 0)
    drawings.HealthBg.Thickness = 2
    drawings.HealthBg.Visible = false
    
    ESP.Objects[player] = drawings
end

function ESP.Remove(player)
    if ESP.Objects[player] then
        for _, v in pairs(ESP.Objects[player]) do
            v:Remove()
        end
        ESP.Objects[player] = nil
    end
end

function ESP.Update()
    if not Settings.ESP.Enabled then
        for _, drawings in pairs(ESP.Objects) do
            for _, d in pairs(drawings) do
                d.Visible = false
            end
        end
        return
    end
    
    local fromPos = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
    
    for player, drawings in pairs(ESP.Objects) do
        local char = player.Character
        if not char then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        local hum = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        
        if not (hum and hum.Health > 0 and hrp and head and isEnemy(player)) then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        local hrpPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
        
        if not onScreen then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        local distance = (hrp.Position - cam.CFrame.Position).Magnitude
        if distance > Settings.ESP.MaxDistance then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end
        
        -- Box
        if Settings.ESP.Boxes then
            local boxHeight = 2500 / distance
            local boxWidth = boxHeight * 0.7
            drawings.Box.Position = Vector2.new(hrpPos.X - boxWidth / 2, hrpPos.Y - boxHeight / 2)
            drawings.Box.Size = Vector2.new(boxWidth, boxHeight)
            drawings.Box.Visible = true
        else
            drawings.Box.Visible = false
        end
        
        -- Name
        if Settings.ESP.Names then
            drawings.Name.Text = player.Name
            drawings.Name.Position = Vector2.new(hrpPos.X, hrpPos.Y - 35)
            drawings.Name.Visible = true
        else
            drawings.Name.Visible = false
        end
        
        -- Distance
        if Settings.ESP.Distance then
            drawings.Distance.Text = string.format("%.0f studs", distance)
            drawings.Distance.Position = Vector2.new(hrpPos.X, hrpPos.Y + 20)
            drawings.Distance.Visible = true
        else
            drawings.Distance.Visible = false
        end
        
        -- Tracer
        if Settings.ESP.Tracers then
            drawings.Tracer.From = fromPos
            drawings.Tracer.To = Vector2.new(hrpPos.X, hrpPos.Y)
            drawings.Tracer.Visible = true
        else
            drawings.Tracer.Visible = false
        end
        
        -- Health Bar
        if Settings.ESP.HealthBar then
            local health = hum.Health / hum.MaxHealth
            local barX = hrpPos.X - 30
            local barY = hrpPos.Y - 25
            local barHeight = 50
            
            drawings.HealthBg.From = Vector2.new(barX, barY)
            drawings.HealthBg.To = Vector2.new(barX, barY + barHeight)
            drawings.HealthBg.Visible = true
            
            drawings.HealthBar.From = Vector2.new(barX, barY + barHeight * (1 - health))
            drawings.HealthBar.To = Vector2.new(barX, barY + barHeight)
            drawings.HealthBar.Color = Color3.fromRGB(1 - health, health, 0)
            drawings.HealthBar.Visible = true
        else
            drawings.HealthBar.Visible = false
            drawings.HealthBg.Visible = false
        end
    end
end

--------------------------------------------------
-- AIMBOT
--------------------------------------------------
local function getTarget()
    if not Settings.Aimbot.Enabled then return nil end
    
    local best, bestDist = nil, Settings.Aimbot.FOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        
        local char = player.Character
        if not char then continue end
        
        local target = char:FindFirstChild(Settings.Aimbot.TargetPart)
        if not target then continue end
        
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        -- VISIBILITY CHECK - actually works now
        if Settings.Aimbot.VisibilityCheck and not isVisible(target) then
            continue
        end
        
        local pos, onScreen = cam:WorldToViewportPoint(target.Position)
        if not onScreen then continue end
        
        local distance = (Vector2.new(pos.X, pos.Y) - 
            Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)).Magnitude
        
        if distance < bestDist then
            bestDist = distance
            best = target
        end
    end
    
    return best
end

--------------------------------------------------
-- FLY SYSTEM
--------------------------------------------------
local flyBody, flyGyro

local function updateFly()
    if Settings.Fly.Enabled then
        local hrp = getHRP()
        
        if not flyBody then
            flyBody = Instance.new("BodyVelocity", hrp)
            flyBody.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            flyBody.Velocity = Vector3.zero
            
            flyGyro = Instance.new("BodyGyro", hrp)
            flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            flyGyro.D = 100
            flyGyro.P = 10000
        end
        
        local velocity = Vector3.zero
        
        if UIS:IsKeyDown(Enum.KeyCode.W) then velocity += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then velocity -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then velocity -= cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then velocity += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then velocity += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then velocity -= Vector3.new(0, 1, 0) end
        
        if velocity.Magnitude > 0 then
            velocity = velocity.Unit * Settings.Fly.Speed
        end
        
        flyBody.Velocity = velocity
        flyGyro.CFrame = cam.CFrame
    else
        if flyBody then flyBody:Destroy() flyBody = nil end
        if flyGyro then flyGyro:Destroy() flyGyro = nil end
    end
end

