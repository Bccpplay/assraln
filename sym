        bar.Size = UDim2.new(1, 0, 0, 12)
        bar.Position = UDim2.new(0, 0, 0.5, -6)
        bar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        bar.ZIndex = 5
        Instance.new("UICorner", bar)
        
        local fill = Instance.new("Frame")
        fill.Parent = bar
        fill.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        fill.ZIndex = 6
        Instance.new("UICorner", fill)
        
        -- Value label
        local valLabel = Instance.new("TextLabel")
        valLabel.Parent = container
        valLabel.Size = UDim2.new(0, 40, 0, 12)
        valLabel.Position = UDim2.new(1, -40, 0.5, 6)
        valLabel.BackgroundTransparency = 1
        valLabel.Text = tostring(value)
        valLabel.Font = Enum.Font.Gotham
        valLabel.TextSize = 10
        valLabel.TextColor3 = Color3.fromRGB(180, 0, 255)
        valLabel.TextXAlignment = Enum.TextXAlignment.Right
        valLabel.ZIndex = 6
        
        local dragging = false
        
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
            end
        end)
        
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        UIS.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local mousePos = UIS:GetMouseLocation()
                local pct = math.clamp(
                    (mousePos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
                    0, 1
                )
                local newVal = math.floor(min + pct * (max - min))
                fill.Size = UDim2.new(pct, 0, 1, 0)
                valLabel.Text = tostring(newVal)
                callback(newVal)
            end
        end)
        
        return fill
    end
    
