--------------------------------------------------
-- UTILITY FUNCTIONS
--------------------------------------------------
local function getChar()
    return plr.Character or plr.CharacterAdded:Wait()
end

local function getHum()
    return getChar():WaitForChild("Humanoid")
end

local function getHRP()
    return getChar():WaitForChild("HumanoidRootPart")
end

local function isEnemy(p)
    if p == plr then return false end
    if not Settings.ESP.TeamCheck then return true end
    
    if plr.Team and p.Team then
        return p.Team ~= plr.Team
    end
    return true
end

local function isVisible(target)
    if not Settings.Aimbot.VisibilityCheck then return true end
    
    local origin = cam.CFrame.Position
    local direction = (target.Position - origin).Unit * (target.Position - origin).Magnitude
    
    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Blacklist
    ray.FilterDescendantsInstances = {plr.Character}
    
    local result = workspace:Raycast(origin, direction, ray)
    return result == nil or result.Instance:IsDescendantOf(target.Parent)
end

