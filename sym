local circle = Drawing.new("Circle")
circle.Color = Color3.fromRGB(180, 0, 255)
circle.Thickness = 1.5
circle.Filled = false
circle.Transparency = 0.7

local function updateFOV()
    circle.Visible = Settings.Visuals.FOVCircle
    circle.Radius = Settings.Aimbot.FOV
    circle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------
RS.RenderStepped:Connect(function(deltaTime)
    updateMovement()
    updateFly()
    ESP.Update()
    updateFOV()
    
    -- Aimbot
    if Settings.Aimbot.Enabled then
        local target = getTarget()
        if target then
            local targetCFrame = CFrame.new(cam.CFrame.Position, target.Position)
            if Settings.Aimbot.Smoothness > 1 then
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, 1 / Settings.Aimbot.Smoothness)
            else
                cam.CFrame = targetCFrame
            end
        end
    end
end)

--------------------------------------------------
-- INPUT HANDLING
--------------------------------------------------
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.X then
        Settings.Fly.Enabled = not Settings.Fly.Enabled
        if GUI.Objects.Buttons and GUI.Objects.Buttons.Fly then
            GUI.Objects.Buttons.Fly.Text = "Fly: " .. (Settings.Fly.Enabled and "ON" or "OFF") .. " (X)"
        end
    elseif input.KeyCode == Enum.KeyCode.Z then
        Settings.Aimbot.Enabled = not Settings.Aimbot.Enabled
        if GUI.Objects.Buttons and GUI.Objects.Buttons.Aimbot then
            GUI.Objects.Buttons.Aimbot.Text = "Aimbot: " .. (Settings.Aimbot.Enabled and "ON" or "OFF")
        end
    end
end)

