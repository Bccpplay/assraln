    scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scrollFrame.ScrollingDirection = Enum.ScrollingDirection.Y
    scrollFrame.ZIndex = 5
    
    -- TOP BAR for minimize button
    local topBar = Instance.new("Frame", mainContainer)
    topBar.Size = UDim2.new(1, 0, 0, 30)
    topBar.Position = UDim2.new(0, 0, 0, 0)
    topBar.BackgroundTransparency = 1
    topBar.ZIndex = 15
    
    -- MINIMIZE BUTTON - using TextButton with proper click handling
    local minBtn = Instance.new("TextButton", topBar)
    minBtn.Size = UDim2.fromOffset(36, 24)
    minBtn.Position = UDim2.new(1, -44, 0, 3)
    minBtn.Text = "—"
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 22
    minBtn.TextColor3 = Color3.new(1, 1, 1)
    minBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 220)
    minBtn.ZIndex = 20
    minBtn.AutoButtonColor = true
    Instance.new("UICorner", minBtn)
    
    -- MINIMIZED TAB (separate, draggable button to restore)
    local minimizedTab = Instance.new("TextButton", screenGui)
    minimizedTab.Size = UDim2.fromOffset(160, 36)
    minimizedTab.Position = UDim2.new(0.5, -80, 0.25, 0)
    minimizedTab.Text = "🔽 Open Menu"
    minimizedTab.Font = Enum.Font.GothamBold
    minimizedTab.TextSize = 14
    minimizedTab.TextColor3 = Color3.new(1, 1, 1)
    minimizedTab.BackgroundColor3 = Color3.fromRGB(150, 0, 220)
    minimizedTab.Visible = false
    minimizedTab.Active = true
    minimizedTab.Draggable = true
    minimizedTab.ZIndex = 100
    minimizedTab.AutoButtonColor = true
    Instance.new("UICorner", minimizedTab)
    Instance.new("UIStroke", minimizedTab).Color = Color3.fromRGB(180, 0, 255)
    
    -- CLOSE BUTTON - separate X button for full close
    local closeBtn = Instance.new("TextButton", topBar)
    closeBtn.Size = UDim2.fromOffset(36, 24)
    closeBtn.Position = UDim2.new(1, -84, 0, 3)
    closeBtn.Text = "✕"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 16
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    closeBtn.ZIndex = 20
    closeBtn.AutoButtonColor = true
    Instance.new("UICorner", closeBtn)
    
    -- CLICK HANDLERS
    local function minimizeMenu()
        mainContainer.Visible = false
        titleLabel.Visible = false
        minimizedTab.Visible = true
    end
    
    local function restoreMenu()
        mainContainer.Visible = true
        titleLabel.Visible = true
        minimizedTab.Visible = false
    end
    
    local menuVisible = true
    
    minBtn.MouseButton1Click:Connect(function()
        minimizeMenu()
    end)
    
    minimizedTab.MouseButton1Click:Connect(function()
        restoreMenu()
    end)
    
    closeBtn.MouseButton1Click:Connect(function()
        menuVisible = not menuVisible
        mainContainer.Visible = menuVisible
        titleLabel.Visible = menuVisible
        minimizedTab.Visible = not menuVisible and false
        
        if not menuVisible then
            closeBtn.Text = "◀"
        else
            closeBtn.Text = "✕"
        end
    end)
    
    -- KEYBOARD SHORTCUT: RightShift to toggle menu
    UIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.RightShift then
            if mainContainer.Visible then
                minimizeMenu()
            else
                restoreMenu()
            end
        end
    end)
    
    -- UI CREATION FUNCTIONS
    local function addButton(y, text, callback)
        local btn = Instance.new("TextButton", scrollFrame)
        btn.Size = UDim2.new(1, -20, 0, 30)
        btn.Position = UDim2.new(0, 10, 0, y)
        btn.Text = text
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.BackgroundColor3 = Color3.fromRGB(150, 0, 220)
        btn.AutoButtonColor = true
        btn.ZIndex = 5
        Instance.new("UICorner", btn)
        btn.MouseButton1Click:Connect(function()
            callback(btn)
        end)
        return btn
    end
    
    local function addLabel(y, text)
        local lbl = Instance.new("TextLabel", scrollFrame)
        lbl.Size = UDim2.new(1, -20, 0, 18)
        lbl.Position = UDim2.new(0, 10, 0, y)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 5
        return lbl
    end
    
    local function addSlider(y, min, max, value, callback)
        local bar = Instance.new("Frame", scrollFrame)
        bar.Size = UDim2.new(1, -20, 0, 12)
        bar.Position = UDim2.new(0, 10, 0, y)
        bar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        bar.ZIndex = 5
        Instance.new("UICorner", bar)
        
        local fill = Instance.new("Frame", bar)
        fill.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        fill.ZIndex = 5
        Instance.new("UICorner", fill)
        
        local dragging = false
        
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
            end
        end)
        
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        UIS.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local mousePos = UIS:GetMouseLocation()
                local pct = math.clamp(
                    (mousePos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
                    0, 1
                )
                fill.Size = UDim2.new(pct, 0, 1, 0)
                callback(math.floor(min + pct * (max - min)))
            end
        end)
        
        return fill
    end
    
    -- Create all buttons
    local y = 10
    
    guiButtons.Aimbot = addButton(y, "Aimbot: ON", function(b)
        Settings.Aimbot.Enabled = not Settings.Aimbot.Enabled
        b.Text = "Aimbot: " .. (Settings.Aimbot.Enabled and "ON" or "OFF")
    end)
    y += 36
    
    guiButtons.ESP = addButton(y, "ESP: ON", function(b)
        Settings.ESP.Enabled = not Settings.ESP.Enabled
        b.Text = "ESP: " .. (Settings.ESP.Enabled and "ON" or "OFF")
    end)
    y += 36
    
    guiButtons.Tracers = addButton(y, "Tracers: ON", function(b)
        Settings.ESP.Tracers = not Settings.ESP.Tracers
        b.Text = "Tracers: " .. (Settings.ESP.Tracers and "ON" or "OFF")
    end)
    y += 36
    
    guiButtons.Boxes = addButton(y, "ESP Boxes: ON", function(b)
        Settings.ESP.Boxes = not Settings.ESP.Boxes
        b.Text = "ESP Boxes: " .. (Settings.ESP.Boxes and "ON" or "OFF")
    end)
    y += 36
    
    guiButtons.TeamCheck = addButton(y, "Team Check: ON", function(b)
        Settings.ESP.TeamCheck = not Settings.ESP.TeamCheck
        b.Text = "Team Check: " .. (Settings.ESP.TeamCheck and "ON" or "OFF")
    end)
    y += 36
    
    guiButtons.VisibilityCheck = addButton(y, "Vis Check: ON", function(b)
        Settings.Aimbot.VisibilityCheck = not Settings.Aimbot.VisibilityCheck
        b.Text = "Vis Check: " .. (Settings.Aimbot.VisibilityCheck and "ON" or "OFF")
    end)
    y += 36
    
    guiButtons.Fly = addButton(y, "Fly: OFF (X)", function(b)
        Settings.Fly.Enabled = not Settings.Fly.Enabled
        b.Text = "Fly: " .. (Settings.Fly.Enabled and "ON" or "OFF") .. " (X)"
    end)
    y += 36
    
    guiButtons.FOV = addButton(y, "FOV Circle: ON", function(b)
        Settings.Visuals.FOVCircle = not Settings.Visuals.FOVCircle
        b.Text = "FOV Circle: " .. (Settings.Visuals.FOVCircle and "ON" or "OFF")
    end)
    y += 36
    
    guiButtons.InfJump = addButton(y, "Infinite Jump: OFF", function(b)
        Settings.Movement.InfiniteJump = not Settings.Movement.InfiniteJump
        b.Text = "Infinite Jump: " .. (Settings.Movement.InfiniteJump and "ON" or "OFF")
    end)
    y += 36
    
    -- Sliders
    y += 10
    addLabel(y, "FOV Size")
    y += 20
    addSlider(y, 50, 400, Settings.Aimbot.FOV, function(v)
        Settings.Aimbot.FOV = v
    end)
    y += 30
    
    addLabel(y, "Walk Speed")
    y += 20
    addSlider(y, 16, 200, Settings.Movement.WalkSpeed, function(v)
        Settings.Movement.WalkSpeed = v
    end)
    y += 30
    
    addLabel(y, "Fly Speed")
    y += 20
    addSlider(y, 20, 200, Settings.Fly.Speed, function(v)
        Settings.Fly.Speed = v
    end)
    y += 30
    
    addLabel(y, "Aimbot Smoothness")
    y += 20
    addSlider(y, 1, 20, Settings.Aimbot.Smoothness, function(v)
        Settings.Aimbot.Smoothness = v
    end)
    
    print("[Unknown Hub] GUI loaded successfully!")
    print("[Unknown Hub] Press RightShift to toggle menu")
    print("[Unknown Hub] Click '—' to minimize, '✕' to hide, minimized tab to restore")
end

